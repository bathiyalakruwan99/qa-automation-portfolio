# Northstar Logistics demo app (runs locally; started automatically by Playwright).
# All values are fake and match no real system.
DEMO_BASE_URL=http://127.0.0.1:3000
DEMO_USERNAME=demo.user@example.test
DEMO_PASSWORD=demo-password

# Enables /api/test/* hooks (store reset, fault injection). Never enable outside local/CI test runs.
DEMO_TEST_MODE=1

# Set to 1 only if you deliberately point the suite at a non-local target you control.
ALLOW_EXTERNAL_TARGET=0
