{
  "name": "smart-qa-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript reference framework with a local Northstar Logistics demo app. Synthetic data only.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "demo:start": "tsx demo-app/src/main.ts",
    "demo:start:test": "tsx demo-app/src/main.ts --test-mode",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --grep @ui",
    "test:hybrid": "playwright test --grep @hybrid",
    "test:negative": "playwright test --grep @negative",
    "test:diagnostic": "playwright test --grep @diagnostic",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "report": "playwright show-report",
    "test:postman": "newman run postman/demo-api.postman_collection.json -e postman/demo-api.postman_environment.json",
    "perf:smoke": "k6 run k6/smoke.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.13.0",
    "newman": "6.2.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
