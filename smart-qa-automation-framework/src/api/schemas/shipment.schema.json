{
  "$id": "shipment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipmentId",
    "reference",
    "customerId",
    "vehicleType",
    "origin",
    "destination",
    "weightKg",
    "status",
    "vehicleId",
    "tasks",
    "history",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "shipmentId": { "type": "string", "pattern": "^DEMO-SHP-[0-9]+$" },
    "reference": { "type": "string", "minLength": 3, "maxLength": 40 },
    "customerId": { "type": "string" },
    "vehicleType": { "enum": ["TRUCK", "VAN", "REEFER"] },
    "origin": { "type": "string" },
    "destination": { "type": "string" },
    "weightKg": { "type": "number", "exclusiveMinimum": 0, "maximum": 30000 },
    "status": {
      "enum": ["CREATED", "ASSIGNED", "ROUTE_PLANNED", "IN_TRANSIT", "DELIVERED", "CLOSED", "CANCELLED"]
    },
    "vehicleId": { "type": ["string", "null"] },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "status", "completedAt"],
        "properties": {
          "type": { "enum": ["LOADING", "TRANSIT", "UNLOADING"] },
          "status": { "enum": ["PENDING", "DONE"] },
          "completedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at"],
        "properties": {
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
