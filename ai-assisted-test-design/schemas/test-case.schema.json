{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/test-case-set.json",
  "title": "Test case set (AI-drafted or human-written)",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirementId", "draftedBy", "reviewStatus", "cases"],
  "properties": {
    "_note": { "type": "string", "description": "Free-text note about the document (e.g. that it is fictional)." },
    "requirementId": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
    "draftedBy": { "enum": ["ai", "human"] },
    "reviewStatus": {
      "description": "DRAFT until a human has reviewed every case. Only a human sets APPROVED.",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "REJECTED"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "priority", "steps", "traceability", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 8 },
          "type": { "enum": ["positive", "negative", "boundary", "workflow"] },
          "priority": { "enum": ["P1", "P2", "P3"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string", "minLength": 3 },
                "expected": { "type": "string", "minLength": 3 }
              }
            }
          },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptanceCriteria"],
            "properties": {
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
              }
            }
          },
          "assumptions": {
            "description": "Anything the drafter assumed that the requirement does not state.",
            "type": "array",
            "items": { "type": "string" }
          },
          "openQuestions": { "type": "array", "items": { "type": "string" } },
          "confidence": {
            "description": "The drafter's own confidence that the case matches the requirement.",
            "enum": ["low", "medium", "high"]
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer", "decision"],
            "properties": {
              "reviewer": { "type": "string", "minLength": 2 },
              "decision": { "enum": ["approve", "change", "reject"] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
